      "text": "Functional requirements:\n      - create a short URL from long URL\n      - optional: support expiration URL\n      - optional: support Custom URL\n      - User should get redirected to long URL\n        from short URL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n      - create a short URL from long URL\n      - optional: support expiration URL\n      - optional: support Custom URL\n      - User should get redirected to long URL\n        from short URL",
      "autoResize": true,
