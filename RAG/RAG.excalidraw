      "seed": 1146843102,
      "version": 294,
      "versionNonce": 397716812,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786555961848,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n      - create a short URL from long URL\n      - optional: support expiration URL\n      - optional: support Custom URL\n      - User should get redirected to long URL\n        from short URL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n      - create a short URL from long URL\n      - optional: support expiration URL\n      - optional: support Custom URL\n      - User should get redirected to long URL\n        from short URL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GrFLPv3s8Avu1etdndbcr",
      "type": "text",
      "x": 892.8908107735747,
      "y": 221.31292142256783,
      "width": 509.69964599609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1412813214,
      "version": 151,
      "versionNonce": 1831902580,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786555961848,
      "link": null,
      "locked": false,
      "text": "Non-Functional requirements:\n    - low latency (redirect ~ 200ms) - response fast\n    - shorten URL should be unique\n    - ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional requirements:\n    - low latency (redirect ~ 200ms) - response fast\n    - shorten URL should be unique\n    - ",
      "autoResize": true,
      "lineHeight": 1.25
    },
