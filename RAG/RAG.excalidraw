    {
      "id": "-apqGd5eFqBDW3-1Ep0NY",
      "type": "text",
      "x": 262.41390141572674,
      "y": 2103.5026794631735,
      "width": 1337.9990234375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2r",
      "roundness": null,
      "seed": 2017456716,
      "version": 469,
      "versionNonce": 1386904012,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786558272706,
      "link": null,
      "locked": false,
      "text": "- Retrieval-Augmented Generation is a architecture where relevant info from sources and provide to LLM as a context before generation.\n- Why do need it? - LLM don't have specific-domain knowledge, hallucination, limited context window.\n- RAG allows keep knowledge updated outside of independent of LLM\n- Docs -> Embeddings -> Vector DB -> retrive relevant chunks -> LLM -> answer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Retrieval-Augmented Generation is a architecture where relevant info from sources and provide to LLM as a context before generation.\n- Why do need it? - LLM don't have specific-domain knowledge, hallucination, limited context window.\n- RAG allows keep knowledge updated outside of independent of LLM\n- Docs -> Embeddings -> Vector DB -> retrive relevant chunks -> LLM -> answer",
      "autoResize": true,
      "lineHeight": 1.25
    },
