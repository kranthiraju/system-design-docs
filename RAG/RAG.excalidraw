      "updated": 1786555961848,
      "link": null,
      "locked": false,
      "text": "2. Identify Entities:\n        - shortURL\n        - longURL\n        - expiration date\n\n3. API Desgin:\n    - POST /v1/url -> shortURL\n    {\n        longURL,\n        expirationDate?,\n        customURL?,\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Identify Entities:\n        - shortURL\n        - longURL\n        - expiration date\n\n3. API Desgin:\n    - POST /v1/url -> shortURL\n    {\n        longURL,\n        expirationDate?,\n        customURL?,\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
