      "link": null,
      "locked": false,
      "text": "┌──────────────────┐\n                    │   User Query     │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │ Query Processing │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │    Retriever     │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │   Vector DB      │\n                    │   / Search       │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │    Reranker      │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │ Context Assembly │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │       LLM        │\n                    └────────┬─────────┘\n                             ↓\n                    ┌──────────────────┐\n                    │ Guardrails /     │\n                    │ Validation       │\n                    └────────┬─────────┘\n                             ↓\n                         Response",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
