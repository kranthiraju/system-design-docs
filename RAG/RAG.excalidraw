    {
      "id": "xq0R_WP8cdWsb-xBS2ZgW",
      "type": "text",
      "x": 255.2829617773839,
      "y": 4180.136650880924,
      "width": 1212.1192626953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2y",
      "roundness": null,
      "seed": 390077684,
      "version": 1210,
      "versionNonce": 312040052,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786644040946,
      "link": null,
      "locked": false,
      "text": "6. Top-K: retrieving the K-most relevant results according to retrieval system\n    - K means tuning parameter, increasing K improves recall but return irrelevant context, increase token cost, reduce quality",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Top-K: retrieving the K-most relevant results according to retrieval system\n    - K means tuning parameter, increasing K improves recall but return irrelevant context, increase token cost, reduce quality",
      "autoResize": true,
      "lineHeight": 1.25
    },
