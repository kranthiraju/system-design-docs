    {
      "id": "wbdtC6QdBfLLlPpiX4eFJ",
      "type": "text",
      "x": 3195.7546652905276,
      "y": -94.61840480901355,
      "width": 809.179443359375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
