      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 2002471426,
      "version": 146,
      "versionNonce": 352333378,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1787558156626,
      "link": null,
      "locked": false,
      "text": "DRY: Don’t Repeat Yourself\n- says that each piece of knowledge in your system should live in exactly one place\n- Don't repeat the same logic/bussiness rules/config\n- use Create a Utility Class then use it across modules",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DRY: Don’t Repeat Yourself\n- says that each piece of knowledge in your system should live in exactly one place\n- Don't repeat the same logic/bussiness rules/config\n- use Create a Utility Class then use it across modules",
      "autoResize": true,
      "lineHeight": 1.25
    },
