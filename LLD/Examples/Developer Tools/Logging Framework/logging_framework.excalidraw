    {
      "id": "LbYqhu8Yfa_DEZ7xl4V0A",
      "type": "text",
      "x": 715,
      "y": 222.5,
      "width": 561.399658203125,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1004522376,
      "version": 776,
      "versionNonce": 225886456,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787675972190,
      "link": null,
      "locked": false,
      "text": "1. Clarify Requirements:\n    - support LOG levels - INFO, WARN, ERROR, DEBUG\n    - destination output - file, console, database\n    - Each log contain - level, timestamp, content message\n    - config setting for levels, output destination\n    - LogFormatter: text, json, xml\n    - concurrent write logs, thread saftey\n    - allow new level, output destinations in future\n\n2. Entities:\n    - LoggingManager: main system for logging mechinsm\n    - LogAppender: console, file, database\n    - LogFormatter: text, json, xml\n    - Logger: collects logs based on config\n    - LoggerConfig: logLevel, list<logAppender>\n    - LogMessage: lvl, timestamp, content\n\n3. Class Design:\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Clarify Requirements:\n    - support LOG levels - INFO, WARN, ERROR, DEBUG\n    - destination output - file, console, database\n    - Each log contain - level, timestamp, content message\n    - config setting for levels, output destination\n    - LogFormatter: text, json, xml\n    - concurrent write logs, thread saftey\n    - allow new level, output destinations in future\n\n2. Entities:\n    - LoggingManager: main system for logging mechinsm\n    - LogAppender: console, file, database\n    - LogFormatter: text, json, xml\n    - Logger: collects logs based on config\n    - LoggerConfig: logLevel, list<logAppender>\n    - LogMessage: lvl, timestamp, content\n\n3. Class Design:\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
